---
import '../styles/global.css';
import { site } from '../site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${site.name} — Barber`,
	description = `${site.name}. Fresh fades, clean cuts. ${site.tagline}.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/bg.jpg" />
		<meta property="og:type" content="website" />
		<link rel="preload" href="/HorndonD.ttf" as="font" type="font/ttf" crossorigin />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<noscript>
			<style>
				.reveal {
					opacity: 1;
					transform: none;
				}
			</style>
		</noscript>
	</head>
	<body class="bg-night text-starlight font-sans">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-coral focus:text-night-deep focus:px-4 focus:py-2"
			>Skip to content</a
		>
		<slot />
	</body>
</html>
