---
// TEMPORARY comparison page for picking a cuts frame style. Delete once chosen.
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';

const variants = [
	{ id: 'cut-frame', label: 'A — dark matte + hairline rule (current)' },
	{ id: 'cut-b', label: 'B — thin black border only (2px)' },
	{ id: 'cut-c', label: 'C — thick black mat (10px)' },
	{ id: 'cut-d', label: 'D — coral hairline, flush' },
	{ id: 'cut-e', label: 'E — black mat + inset light rule (double)' },
	{ id: 'cut-f', label: 'F — borderless, rounded + deep shadow' },
	{ id: 'cut-g', label: 'G — no frame at all' },
];
---

<Layout>
	<main class="py-10">
		{
			variants.map((v) => (
				<div>
					<p class="mx-auto max-w-6xl px-5 font-mono text-xs uppercase tracking-[0.25em] text-coral">
						{v.label}
					</p>
					<Gallery frameClass={v.id} />
					<hr class="mx-auto max-w-6xl border-starlight/10" />
				</div>
			))
		}
	</main>
</Layout>

<script>
	document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
</script>
