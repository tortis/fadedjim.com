---
import { site } from '../site';
import data from '../data/data.json';
import Scissors from './Scissors.astro';

const { copy } = data;
---

<section
	id="top"
	class="grain relative flex min-h-svh flex-col items-center justify-center overflow-hidden"
>
	<!-- Backdrop: the textless brand sky -->
	<img
		src="/sky.jpg"
		alt=""
		aria-hidden="true"
		class="absolute inset-0 h-full w-full object-cover object-[center_70%]"
	/>
	<!-- Ember glow rising from the bottom -->
	<div
		class="absolute inset-0 bg-gradient-to-t from-ember/40 via-night/40 to-transparent"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute inset-0 bg-gradient-to-b from-night/60 via-transparent to-night/40"
		aria-hidden="true"
	>
	</div>

	<!-- Twinkling stars + shooting star (populated by script) -->
	<div id="starfield" class="absolute inset-0" aria-hidden="true"></div>
	<div id="shooter" class="shooting-star" style="top: 18%; right: 20%;" aria-hidden="true"></div>

	<!-- Long fade into the page background so the section seam is invisible -->
	<div class="hero-fade" aria-hidden="true"></div>

	<div class="relative z-10 flex flex-col items-center px-6 text-center">
		<h1
			class="reveal font-display text-7xl leading-[0.95] text-coral drop-shadow-[0_4px_24px_rgba(224,101,95,0.35)] sm:text-8xl md:text-9xl"
		>
			Tell Your<br />Friends
		</h1>
		<p
			class="reveal mt-6 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.35em] text-blush sm:text-sm"
		>
			<Scissors class="size-4 text-coral" /> {copy.hero_subtitle}
		</p>
		<a href={site.bookingUrl} class="btn reveal mt-10 text-xl">Book Now</a>
		<a
			href={site.instagram.url}
			target="_blank"
			rel="noopener noreferrer"
			class="reveal mt-8 inline-flex items-center gap-2 rounded-full border-2 border-coral/70 px-5 py-2 font-mono text-xs uppercase tracking-[0.2em] text-coral transition-colors hover:bg-coral hover:text-night-deep"
		>
			{site.instagram.handle} on Instagram
		</a>
	</div>

	<!-- Scroll hint -->
	<a
		href="#cuts"
		class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 font-mono text-xs uppercase tracking-[0.25em] text-starlight/50 transition-colors hover:text-coral"
	>
		See the cuts
		<span class="animate-bounce" aria-hidden="true">↓</span>
	</a>
</section>

<script>
	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Twinkling stars
	const field = document.getElementById('starfield');
	if (field && !prefersReduced) {
		const count = window.innerWidth < 640 ? 40 : 80;
		for (let i = 0; i < count; i++) {
			const star = document.createElement('span');
			const size = Math.random() * 2.5 + 1;
			star.className = 'star';
			star.style.width = `${size}px`;
			star.style.height = `${size}px`;
			star.style.left = `${Math.random() * 100}%`;
			star.style.top = `${Math.random() * 100}%`;
			star.style.setProperty('--tw-duration', `${2 + Math.random() * 4}s`);
			// Negative delay: starts each star mid-cycle so the sky looks settled on load
			star.style.setProperty('--tw-delay', `${-Math.random() * 6}s`);
			field.appendChild(star);
		}
	}

	// Occasional shooting star, alternating between a few flight paths
	const shooter = document.getElementById('shooter');
	if (shooter && !prefersReduced) {
		const paths = ['fire-a', 'fire-b', 'fire-c'];
		let last = -1;
		const fire = () => {
			let i = Math.floor(Math.random() * paths.length);
			if (i === last) i = (i + 1) % paths.length; // never the same path twice in a row
			last = i;
			shooter.style.top = `${5 + Math.random() * 30}%`;
			shooter.style.right = `${Math.random() * 40}%`;
			shooter.classList.remove(...paths);
			void shooter.offsetWidth; // restart animation
			shooter.classList.add(paths[i]);
		};
		setTimeout(() => {
			fire();
			setInterval(fire, 7000);
		}, 1500);
	}
</script>
