---
import { site } from '../site';
import data from '../data/data.json';

const { copy } = data;

const year = new Date().getFullYear();
---

<footer class="grain relative overflow-hidden">
	<!-- Ember horizon from the brand sky -->
	<img
		src="/sky.jpg"
		alt=""
		aria-hidden="true"
		class="absolute inset-0 h-full w-full object-cover object-bottom"
	/>
	<div
		class="absolute inset-0 bg-gradient-to-b from-night via-night/60 to-transparent"
		aria-hidden="true"
	>
	</div>
	<!-- Long fade out of the page background so the section seam is invisible -->
	<div class="footer-fade" aria-hidden="true"></div>

	<div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center px-6 pt-24 pb-10 text-center sm:pt-32">
		<h2 class="reveal font-display text-6xl text-coral drop-shadow-[0_4px_24px_rgba(0,0,0,0.5)] sm:text-7xl">
			Tell your<br />friends
		</h2>
		<a href={site.bookingUrl} class="btn reveal mt-10 text-2xl">Book Now</a>
		<p class="reveal mt-12 font-mono text-xs tracking-[0.25em] text-starlight/80 uppercase">
			{copy.footer_follow_line}
		</p>
		<a
			href={site.instagram.url}
			target="_blank"
			rel="noopener noreferrer"
			class="reveal mt-4 inline-flex items-center gap-2 rounded-full border-2 border-coral/70 bg-night-deep/40 px-6 py-2.5 font-mono text-sm uppercase tracking-[0.2em] text-coral transition-colors hover:bg-coral hover:text-night-deep"
		>
			{site.instagram.handle}
		</a>
		<p class="mt-16 font-mono text-[10px] tracking-[0.3em] text-starlight/50 uppercase">
			© {year} Faded Jim — All rights reserved
		</p>
	</div>
</footer>
