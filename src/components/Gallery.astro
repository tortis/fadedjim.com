---
import { Image } from 'astro:assets';
import { site } from '../site';
import data from '../data/data.json';

const { cuts } = data;

const images = import.meta.glob<{ default: ImageMetadata }>('../data/images/*.{jpg,jpeg,png}', {
	eager: true,
});

const rotations = ['lg:-rotate-2', 'lg:rotate-1', 'lg:-rotate-1', 'lg:rotate-2'];
---

<section id="cuts" class="relative mx-auto max-w-6xl scroll-mt-24 px-5 py-20 sm:py-28">
	<!-- Mobile: snap carousel / Desktop: tilted grid -->
	<div
		class="reveal flex snap-x snap-mandatory gap-6 overflow-x-auto pb-6 lg:grid lg:grid-cols-4 lg:overflow-visible lg:pb-0"
	>
		{
			cuts.map((cut, i) => (
				<div
					class={`polaroid relative w-72 shrink-0 snap-center border-8 border-starlight bg-starlight shadow-xl lg:w-auto ${rotations[i % rotations.length]}`}
				>
					<Image
						src={images[`../data/images/${cut.image}`]!.default}
						alt={`Haircut by Jim — ${cut.alt}`}
						widths={[300, 600]}
						sizes="(min-width: 1024px) 270px, 288px"
						format="webp"
						quality={80}
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
			))
		}
	</div>

	<p class="reveal mt-4 text-center font-mono text-xs text-starlight/50 lg:hidden">
		← swipe →
	</p>

	<div class="flex justify-center">
	<a
		href={site.instagram.url}
		target="_blank"
		rel="noopener noreferrer"
		class="mt-6 inline-block font-mono text-xs uppercase tracking-[0.25em] text-coral underline decoration-coral/40 underline-offset-8 transition-colors hover:text-blush"
	>
		See more on Instagram →
	</a>
	</div>
</section>
