---
import Scissors from './Scissors.astro';

const cuts = [
	{ label: 'Skin fade', rotate: 'md:-rotate-2' },
	{ label: 'Taper + beard', rotate: 'md:rotate-1' },
	{ label: 'Crop top', rotate: 'md:-rotate-1' },
];
---

<section id="cuts" class="relative mx-auto max-w-6xl scroll-mt-24 px-5 py-20 sm:py-28">
	<div class="reveal mb-12 text-center">
		<p class="font-mono text-xs uppercase tracking-[0.35em] text-coral">The proof</p>
		<h2 class="mt-3 font-display text-5xl text-starlight sm:text-6xl">The Cuts</h2>
	</div>

	<!-- Mobile: snap carousel / Desktop: tilted grid -->
	<div
		class="reveal flex snap-x snap-mandatory gap-6 overflow-x-auto pb-6 md:grid md:grid-cols-3 md:overflow-visible md:pb-0"
	>
		{
			cuts.map((cut) => (
				<figure
					class={`polaroid relative w-72 shrink-0 snap-center border-8 border-starlight bg-starlight shadow-xl md:w-auto ${cut.rotate}`}
				>
					{/* Placeholder — swap for real cut photos */}
					<div class="flex aspect-[4/5] flex-col items-center justify-center gap-3 bg-gradient-to-br from-dusk via-night to-night-deep">
						<Scissors class="size-9 text-coral" />
						<span class="font-mono text-[10px] uppercase tracking-[0.3em] text-starlight/50">
							Photo
						</span>
					</div>
					<figcaption class="bg-starlight py-3 text-center font-mono text-xs uppercase tracking-[0.2em] text-night">
						{cut.label}
					</figcaption>
				</figure>
			))
		}
	</div>

	<p class="reveal mt-4 text-center font-mono text-xs text-starlight/50 md:hidden">
		← swipe →
	</p>
</section>
