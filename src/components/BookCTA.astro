---
import { site } from '../site';

interface Props {
	heading?: string;
	subtext?: string;
}

const {
	heading = 'Ready for a fresh one?',
	subtext = 'Books are open — grab your slot before they’re gone.',
} = Astro.props;
---

<section class="grain relative overflow-hidden bg-dusk/30 py-20 sm:py-28">
	<div
		class="absolute inset-0 bg-gradient-to-b from-night via-transparent to-night"
		aria-hidden="true"
	>
	</div>
	<div class="reveal relative z-10 mx-auto flex max-w-3xl flex-col items-center px-6 text-center">
		<h2 class="font-display text-5xl text-coral sm:text-6xl">{heading}</h2>
		<p class="mt-4 font-light text-starlight/85">{subtext}</p>
		<a href={site.bookingUrl} class="ticket mt-10 text-2xl">Book Now</a>
	</div>
</section>
